### Lotin-Kiril-converter example `.env` values
# Copy this file to `.env` and fill in real values for development.

# Choose one provider: gemini | azure | cloudflare
AI_PROVIDER=gemini

# --- Gemini (Google) ---
# Required if AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# --- Azure OpenAI ---
# Required if AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Cloudflare AI (REST) ---
# Required if AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_ai_scopes
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional runtime config
PORT=3000
NODE_ENV=development

# Notes:
# - Do NOT commit `.env` to source control. Keep secrets safe.
# - For production, use a secrets manager or environment configuration in your hosting platform.
